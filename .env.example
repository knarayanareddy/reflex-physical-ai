# Environment configuration for Reflex
#
# Copy to .env and fill in what you need. Nothing here is required for the offline
# checks: `make sample`, `make test`, `make check` and `make demo` all run without a key.
#
#   cp .env.example .env

# --- Nebius Token Factory ---------------------------------------------------
# Without this, model calls fail fast with a message telling you to set it
# (backend/app/config.py:require_nebius_credentials). There is no fake default.
NEBIUS_API_KEY=
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1/

# --- Pinned model IDs -------------------------------------------------------
# Confirm against your authenticated catalog and record the result in
# data/model-catalog.snapshot.json before relying on them (Phase 0, D-T07).
MODEL_ULTRA=nvidia/Nemotron-3-Ultra-550b-a55b
MODEL_SUPER=nvidia/nemotron-3-super-120b-a12b
MODEL_NANO=nvidia/nemotron-3-nano
MODEL_VISION=nvidia/cosmos-reason-2

# --- Tavily (optional, bonus track) -----------------------------------------
TAVILY_API_KEY=

# --- Runtime ----------------------------------------------------------------
# development | test | production
ENVIRONMENT=development
LOG_LEVEL=INFO

# Sandbox policy flags (consumed in Phase B when the sandbox lane exists)
SANDBOX_NETWORK_DISABLED=true
MOCK_EXTERNAL_CALLS=false

# Where telemetry is appended. Empty = <repo>/runs/ledger.jsonl.
# Set this explicitly in containers (see jobs/Dockerfile: /data/runs/ledger.jsonl).
REFLEX_LEDGER_PATH=

# Where envelope decisions are appended. Empty = <repo>/runs/veto-ledger.jsonl.
# This is the audit trail: one EnvelopeDecision per evaluation, veto or allow.
REFLEX_VETO_LEDGER_PATH=
