# Environment Configuration for Reflex — Deterministic Edge Safety Envelope & Cloud Replay for Physical AI

# Nebius Token Factory
NEBIUS_API_KEY=your_nebius_token_factory_api_key_here
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1/

# Model IDs (Pinned)
MODEL_ULTRA=nvidia/Nemotron-3-Ultra-550b-a55b
MODEL_SUPER=nvidia/nemotron-3-super-120b-a12b
MODEL_NANO=nvidia/nemotron-3-nano
MODEL_VISION=nvidia/cosmos-reason-2

# Tavily Search (Bonus Track / Live Web Currency)
TAVILY_API_KEY=your_tavily_api_key_here

# Runtime Settings
ENVIRONMENT=development
LOG_LEVEL=INFO
SANDBOX_NETWORK_DISABLED=true
MOCK_EXTERNAL_CALLS=false
