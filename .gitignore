# System & OS
.DS_Store
Thumbs.db

# Runtime data (except fixtures & samples)
runs/*.jsonl
!runs/sample_ledger.jsonl
# The veto ledger and the replay output are regenerated by `make replay` (~80 KB of fixture
# data); committing a copy would go stale the first time a rule changed.
runs/replay/
# The 1,000-action session and its sandbox pack are regenerated by
# `python jobs/batch_1000_eval.py` (~12 MB). runs/headline_statistics.json is committed: it is
# the published number, and tests/test_batch_replay.py fails if it stops reproducing.
runs/session/
runs/replay_pack/
# Local calibration output and caches
data/calibration/captures/
data/fixtures/snapshots/.cache/

# Generated: `make pages-data` writes the static replay bundle that the Pages build embeds.
# Rebuilt by `make build-pages` and by the Deploy Pages workflow; committing it would add a 700 kB
# artifact whose measured latencies change on every run.
frontend/public/replay/

# Generated: the demo recorder's scratch space (captured stdout, the raw take, encoder temp).
.record-tmp/
